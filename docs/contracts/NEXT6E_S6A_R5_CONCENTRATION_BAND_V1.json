  },
  "eligibility": [
    "w_n>=2",
    "w_n<=ceil(n/10)",
    "d_n<=w_n",
    "all external model-use parameters are bound",
    "alpha_stat is bound"
  ],
  "raw_band": {
    "central": "[Ftilde-epsilon_core, Ftilde+epsilon_core]",
    "left_tail": "[0,tau_n]",
    "right_tail": "[1-tau_n,1]"
  },
  "cdf_projection": {
    "lower": "L*(x)=max(0,sup_{y<=x}L_raw(y))",
    "upper": "U*(x)=min(1,inf_{y>=x}U_raw(y))",
