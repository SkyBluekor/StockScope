  "status": "THEOREM_DESIGN_FROZEN",
  "estimator": {
    "type": "BACKWARD_DISCRETE_LOCAL_LINEAR_CDF",
    "window_length": "w_n=ceil(n^(1-beta))",
    "bandwidth": "h_n=w_n/n",
    "support": "last w_n observed chronology positions ending at t",
    "weight_index": "r=0,...,w_n-1 where observation index is t-r",
    "weight_formula": "a_{r,w}=2*(2*w-1-3*r)/(w*(w+1))",
    "exact_properties": [
      "sum_r a_{r,w}=1",
      "sum_r r*a_{r,w}=0",
      "max_r |a_{r,w}|<4/w",
      "sum_r |a_{r,w}|<=4",
      "sum_r a_{r,w}^2=2*(2*w-1)/(w*(w+1))<4/w"
    ],
    "future_leakage": false,
    "latest_state_supported_structurally": true
  },
  "model_assumptions": {
    "indicator_finite_memory": {
      "statement": "sup_{n,i,h,x} ||I{X_i^h<=x}-E[I{X_i^h<=x}|epsilon_i,...,epsilon_{i-d+1}]||_1 <= C_dep*rho^d for all d>=1",
      "parameters": {
        "C_dep": ">0",
        "rho": "in (0,1)"
      },
      "binding": "EXTERNAL_MODEL_USE_BINDING_REQUIRED"
    },
    "local_marginal_approximation": {
      "statement": "sup_{i,h,x}|P(X_i^h<=x)-F_h(i/n,x)| <= C_ls*n^(-zeta)",
      "parameters": {
        "C_ls": ">=0",
        "zeta": ">0"
      },
      "binding": "EXTERNAL_MODEL_USE_BINDING_REQUIRED"
    },
    "time_smoothness": {
      "statement": "sup_{h,u,x}|partial_u^2 F_h(u,x)| <= L2",
      "parameters": {
        "L2": ">=0"
      },
      "binding": "EXTERNAL_MODEL_USE_BINDING_REQUIRED"
    },
    "uniform_moment": {
      "statement": "sup_{h,u} E|Xtilde_h(u)|^q <= M_q",
      "parameters": {
        "q": ">0",
        "M_q": "<infinity"
      },
      "binding": "EXTERNAL_MODEL_USE_BINDING_REQUIRED"
    }
  },
  "threshold_domain": {
    "route": "DETERMINISTIC_LATTICE_TRUNCATION",
    "radius": "M_n=ceil(n^mu)",
    "mu": ">0",
    "central_thresholds": "integers x with -M_n<=x<=M_n",
    "tail_width": "tau_n=M_q/M_n^q",
    "full_real_extension": "integer-valued CDF is extended by floor(x)"
  },
  "family": {
    "required_times": "all observed chronology positions from the minimum approved grid anchor through n",
    "horizons": [
      1,
      5,
      10
    ],
    "cardinality_upper_bound": "p_n=3*n*(2*M_n+1)",
    "anchors_are_reused_not_multiplied": true,
    "all_later": true,
    "latest_state": true
  },
  "alpha_allocation": {
    "alpha_stat": "input in (0,1)",
    "finite_memory_approximation": "alpha_stat/2",
    "m_dependent_hoeffding": "alpha_stat/2"
  },
  "finite_memory_depth": {
    "formula": "d_n=ceil(log(16*p_n*C_dep*n/alpha_stat)/(-log(rho)))",
    "required_eligibility": "d_n<=w_n"
  },
  "stochastic_width": {
    "Q_w": "2*(2*w_n-1)/(w_n*(w_n+1))",
