# StockScope local development secrets
# Copy to .env and fill in your own keys. Never commit .env.
KRX_API_KEY=
DART_API_KEY=

ENVIRONMENT=development

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
KIS_ENV=virtual

# Optional runtime DB path overrides.
# Leave blank to use the repository-local backend/runtime defaults.
STOCKSCOPE_HOLDINGS_DB=
STOCKSCOPE_MARKET_STORE_DB=
