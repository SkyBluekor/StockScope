# StockScope local development secrets
# Copy to .env and fill in your own keys. Never commit .env.
KRX_API_KEY=
DART_API_KEY=
FRED_API_KEY=

# NAVER Search News API
# api_hub: NCP NAVER API HUB
# developer_center: legacy NAVER Developers Center
NAVER_NEWS_PROVIDER_KIND=api_hub
NAVER_NEWS_CLIENT_ID=
NAVER_NEWS_CLIENT_SECRET=

# Optional JEV Decision Reviewer provider credential.
# Trial V1 uses the frozen OpenAI Responses adapter, but network activation is off
# until an explicit later test/activation step. Never commit a real secret.
JEV_API_KEY=

ENVIRONMENT=development

KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
KIS_ACCOUNT_PRODUCT_CODE=
KIS_ENV=virtual

# Optional runtime DB path overrides.
# Leave blank to use the repository-local backend/runtime defaults.
STOCKSCOPE_HOLDINGS_DB=
STOCKSCOPE_MARKET_STORE_DB=
STOCKSCOPE_MACRO_DB=
